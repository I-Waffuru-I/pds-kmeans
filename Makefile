# Compiler and flags
CXX := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -O3 -DNDEBUG -march=native -mtune=native -MMD -MP
INCLUDES := -Iinclude -Ilibs
LDFLAGS :=
EXTRAFLAGS :=

# Directories
SRC_DIRS := src libs
BUILD_DIR := build
BIN_DIR := $(BUILD_DIR)/bin
SERIAL_DIR := $(BUILD_DIR)/serial
OMP_DIR := $(BUILD_DIR)/omp
CUDA_DIR := $(BUILD_DIR)/cuda

# Executable targets
SERIAL_TARGET := $(BIN_DIR)/kmeans_serial
OMP_TARGET := $(BIN_DIR)/kmeans_omp
CUDA_TARGET := $(BIN_DIR)/kmeans_cuda

DATA := datasets
OUTPUT := output

THREADS ?= 1

ARGS ?= --input $(DATA)/1Mx4.csv \
	--output $(OUTPUT)/output.csv \
	--repetitions 1 --k 100 \
	--threads $(THREADS) \
	--seed 1337

# ARGS ?= --input $(DATA)/3M_3000000x6.csv \
# 	--output $(OUTPUT)/output.csv \
# 	--repetitions 3 --k 12 \
# 	--threads $(THREADS) \
# 	--seed 1337

# Shared object files (compiled from src/ and libs/)
COMMON_OBJS := kmeans.o naive.o centroids.o helpers.o rng.o

# Per-executable object lists (each gets its own main_*.o + the shared objects)
SERIAL_OBJS := $(addprefix $(SERIAL_DIR)/, main_serial.o $(COMMON_OBJS))
OMP_OBJS    := $(addprefix $(OMP_DIR)/,    main_omp.o    $(COMMON_OBJS))
DEPS        := $(SERIAL_OBJS:.o=.d) $(OMP_OBJS:.o=.d)

# Tell Make where to find .cpp files
vpath %.cpp $(SRC_DIRS)

# Default rule: build both serial and OpenMP executables
all: serial omp

serial: $(SERIAL_TARGET)

omp: $(OMP_TARGET)

kmeans_serial: $(SERIAL_TARGET)

kmeans_omp: $(OMP_TARGET)

# 1. Link object files into executables
$(SERIAL_TARGET): $(SERIAL_OBJS) | $(BIN_DIR)
	$(CXX) $(SERIAL_OBJS) -o $@ $(LDFLAGS)

$(OMP_TARGET): $(OMP_OBJS) | $(BIN_DIR)
	$(CXX) $(OMP_OBJS) -o $@ $(LDFLAGS) -fopenmp

# 2. Compile each .cpp file into its own .o file
$(SERIAL_DIR)/%.o: %.cpp | $(SERIAL_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(OMP_DIR)/%.o: %.cpp | $(OMP_DIR)
	$(CXX) $(CXXFLAGS) -fopenmp -DHAVE_OMP $(INCLUDES) -c $< -o $@

# Create build directories if they do not exist
$(BIN_DIR) $(SERIAL_DIR) $(OMP_DIR) $(CUDA_DIR):
	mkdir -p $@

# Run rules
run: run-serial

run-serial: $(SERIAL_TARGET)
	./$(SERIAL_TARGET) $(ARGS) $(EXTRAFLAGS)

run-omp: $(OMP_TARGET)
	./$(OMP_TARGET) $(ARGS) $(EXTRAFLAGS)

# Debug trace rules
debug: debug-omp

debug-serial: $(SERIAL_TARGET)
	./$(SERIAL_TARGET) $(EXTRAFLAGS) --input $(DATA)/mouse_500x2.csv \
		--output $(OUTPUT)/output.csv \
		--repetitions 10 --k 3 \
		--centroidtrace $(OUTPUT)/centroidtrace.csv \
		--trace $(OUTPUT)/clustertrace.csv --seed 1338

debug-omp: $(OMP_TARGET)
	./$(OMP_TARGET) $(EXTRAFLAGS) --input $(DATA)/mouse_500x2.csv \
		--output $(OUTPUT)/output.csv \
		--repetitions 10 --k 3 \
		--centroidtrace $(OUTPUT)/centroidtrace.csv \
		--trace $(OUTPUT)/clustertrace.csv --seed 1338

# Remove build artifacts
clean:
	rm -rf $(BUILD_DIR) kmeans

# Automatically include header dependencies (.hpp/.h) generated by -MMD -MP
-include $(DEPS)

.PHONY: all serial omp kmeans_serial kmeans_omp run run-serial run-omp debug debug-serial debug-omp clean
