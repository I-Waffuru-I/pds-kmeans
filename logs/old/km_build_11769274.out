== build ==
rm -rf build kmeans
mkdir -p build/serial
mkdir -p build/bin
mkdir -p build/omp
g++ -std=c++17 -Wall -Wextra -O3 -DNDEBUG -march=native -mtune=native -MMD -MP -Iinclude -Ilibs -c src/centroids.cpp -o build/serial/centroids.o
